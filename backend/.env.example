# -----------------------------------------------------------------------
# Wasden Watch — backend environment variables
# Copy to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------

# Required: "paper" or "live". System refuses to start if unset.
TRADING_MODE=paper

# Set to "false" in production to enable live data sources.
USE_MOCK_DATA=true

# Supabase (required for live data and audit log)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS: comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------

# Shared API key for general backend access (empty = auth disabled for dev)
API_KEY=

# Per-approver API keys — required in production for identity-sensitive
# endpoints (approve_proposal, emergency shutdown/resume).
# When either is set, identify_principal() derives identity from the key
# and ignores any user_name field in the request body.
# Both should be set; set to different random secrets.
API_KEY_JOE=
API_KEY_JARED=

# -----------------------------------------------------------------------
# Brokerage (Alpaca)
# -----------------------------------------------------------------------
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# -----------------------------------------------------------------------
# Data providers
# -----------------------------------------------------------------------
FINNHUB_API_KEY=
NEWSAPI_API_KEY=

# -----------------------------------------------------------------------
# MLflow
# -----------------------------------------------------------------------
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=wasden-watch-quant

# -----------------------------------------------------------------------
# Notifications (all optional)
# -----------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_RECIPIENTS=
