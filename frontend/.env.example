# -----------------------------------------------------------------------
# Server-side only (NOT prefixed with NEXT_PUBLIC_)
# These are read by app/api/[...path]/route.ts and never sent to the browser.
# -----------------------------------------------------------------------

# FastAPI backend URL (no trailing slash)
API_URL=http://localhost:8000

# Shared API key — must match the backend API_KEY env var.
# For production set per-approver keys (API_KEY_JOE / API_KEY_JARED) on
# the backend and leave this empty, or set a read-only shared key here.
API_KEY=

# -----------------------------------------------------------------------
# Client-side (safe to expose — no secrets)
# -----------------------------------------------------------------------

# Supabase public credentials (read-only anon key, safe in bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
